<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="background">#0B101C</color>
    <color name="icon_background_start">#16213A</color>
    <color name="icon_background_end">#0A0F1C</color>

    <!-- Only what shows before Compose draws: the app is always dark, like the desktop app. -->
    <style name="Theme.Topal" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">#5EEAD4</item>
    </style>
</resources>
