<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing the app stores is worth backing up or moving to another phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
