{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Topal Encryption",
  "mainBinaryName": "TopalEncryption",
  "version": "0.2.0",
  "identifier": "io.github.abboodan.topalencryption",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Topal Encryption",
        "width": 720,
        "height": 860,
        "minWidth": 600,
        "minHeight": 680,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Encrypt files and folders with a password",
    "copyright": "Abdullah Topal",
    "windows": {
      "nsis": {
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  }
}
